# Workspace contents are per-machine. User documents and the workspace
# registry override (blueprint.types.toml) live locally; the shared
# baseline is the built-in default registry in src/graphFile.ts plus
# per-doc overrides on `GraphFile.registry`.
blueprints/*
!blueprints/.gitkeep
